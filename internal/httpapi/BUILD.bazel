load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "httpapi",
    srcs = [
        "admin.gen.go",
        "admin.go",
        "admin_service.go",
        "artifacts.go",
        "events.go",
        "identity.go",
        "middleware.go",
        "routes.go",
        "runs.go",
        "server.gen.go",
        "service.go",
        "service_config.go",
        "sessions.go",
        "write_timeout_listener.go",
    ],
    importpath = "github.com/polymetrics-ai/pm-cli/internal/httpapi",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/api",
        "//internal/app",
        "//internal/auth",
        "//internal/contract",
        "//internal/store",
        "@com_github_coreos_go_oidc_v3//oidc",
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_oapi_codegen_nullable//:nullable",
        "@com_github_oapi_codegen_runtime//:runtime",
    ],
)

go_test(
    name = "httpapi_test",
    size = "large",
    srcs = [
        "admin_test.go",
        "artifacts_test.go",
        "events_test.go",
        "protocol_test.go",
        "strict_test.go",
    ],
    embed = [":httpapi"],
    env_inherit = [
        "GOMAXPROCS",
        "GOMEMLIMIT",
        "PM_STORE_TEST_SECRETS_DIR",
    ],
    tags = [
        "exclusive",
        "external",
        "no-remote",
    ],
    deps = [
        "//internal/api",
        "//internal/contract",
        "//internal/store",
        "//internal/testfixture",
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_jackc_pgx_v5//:pgx",
    ],
)
