load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "api",
    srcs = [
        "catalog.go",
        "client.gen.go",
        "client.go",
        "controls.gen.go",
        "events.go",
        "output.go",
        "profile.go",
        "protocol.go",
        "session.go",
        "types.gen.go",
    ],
    importpath = "github.com/polymetrics-ai/pm-cli/internal/api",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/contract",
        "@com_github_oapi_codegen_nullable//:nullable",
        "@com_github_oapi_codegen_runtime//:runtime",
        "@com_github_zalando_go_keyring//:go-keyring",
    ],
)

go_test(
    name = "api_test",
    size = "large",
    srcs = [
        "events_test.go",
        "protocol_test.go",
        "session_test.go",
        "version_test.go",
    ],
    data = [
        "//:scripts/generate.sh",
        "//api:admin.openapi.yaml",
        "//api:controls.json",
        "//api:oapi-codegen.yaml",
        "//api:pm.openapi.json",
        "//api:pm.openapi.yaml",
        "//tools/cmd/pm-api-generate",
    ],
    embed = [":api"],
    env = {"PM_API_GENERATE": "$(rootpath //tools/cmd/pm-api-generate)"},
    env_inherit = [
        "GOMAXPROCS",
        "GOMEMLIMIT",
        "HOME",
        "GOCACHE",
        "GOMODCACHE",
        "GOPATH",
        "PM_STACK_ROOT",
        "PM_STACK_SECRETS_DIR",
        "PM_STACK_TEST_CONFIG",
        "PM_STORE_TEST_SECRETS_DIR",
    ],
    tags = [
        "exclusive",
        "external",
        "no-remote",
    ],
    deps = [
        "//internal/contract",
        "//internal/httpapi",
        "//internal/store",
        "//internal/testfixture",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_oapi_codegen_nullable//:nullable",
        "@com_github_santhosh_tekuri_jsonschema_v6//:jsonschema",
        "@com_github_zalando_go_keyring//:go-keyring",
    ],
)
