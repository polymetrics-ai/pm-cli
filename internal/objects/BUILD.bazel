load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "objects",
    srcs = [
        "reservations.go",
        "s3.go",
        "store.go",
        "verify.go",
    ],
    importpath = "github.com/polymetrics-ai/pm-cli/internal/objects",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/contract",
        "//internal/store",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@com_github_aws_smithy_go//:smithy-go",
    ],
)

go_test(
    name = "objects_test",
    size = "large",
    srcs = [
        "backend_test.go",
        "publication_test.go",
    ],
    embed = [":objects"],
    env_inherit = [
        "GOMAXPROCS",
        "GOMEMLIMIT",
        "PM_STACK_SECRETS_DIR",
        "PM_STACK_TEST_CONFIG",
        "PM_STACK_TEST_S3_PRIMARY_ENDPOINT",
        "PM_STACK_TEST_S3_SECONDARY_ENDPOINT",
        "PM_STORE_TEST_SECRETS_DIR",
    ],
    tags = [
        "exclusive",
        "external",
        "no-remote",
    ],
    deps = [
        "//internal/contract",
        "//internal/httpapi",
        "//internal/store",
        "//internal/testfixture",
    ],
)
