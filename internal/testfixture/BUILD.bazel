load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "testfixture",
    srcs = ["fixture.go"],
    importpath = "github.com/polymetrics-ai/pm-cli/internal/testfixture",
    testonly = True,
    visibility = ["//internal:__subpackages__"],
    deps = [
        "//internal/api",
        "//internal/app",
        "//internal/auth",
        "//internal/contract",
        "//internal/httpapi",
        "//internal/store",
        "@com_github_coreos_go_oidc_v3//oidc",
        "@com_github_gin_gonic_gin//:gin",
        "@com_github_jackc_pgx_v5//:pgx",
        "@org_golang_x_oauth2//:oauth2",
    ],
)

go_test(
    name = "testfixture_test",
    size = "large",
    srcs = ["fixture_test.go"],
    env_inherit = [
        "GOMAXPROCS",
        "GOMEMLIMIT",
        "PM_STORE_TEST_SECRETS_DIR",
    ],
    tags = ["exclusive", "external", "no-remote"],
    deps = [":testfixture"],
)
