        "admission_test.go",
        "artifact_test.go",
        "event_test.go",
        "lease_test.go",
        "migrate_test.go",
        "rls_test.go",
        "scope_test.go",
        "store_test.go",
        "tenant_keys_test.go",
    ],
    embed = [":store"],
    env_inherit = [
        "GOMAXPROCS",
        "GOMEMLIMIT",
        "PM_STORE_TEST_SECRETS_DIR",
    ],
    tags = ["exclusive", "external", "no-remote"],
    deps = [
        "//internal/contract",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgconn",
    ],
)
