load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "store",
    srcs = [
        "artifacts.go",
        "audit.go",
        "budgets.go",
        "checkpoints.go",
        "connections.go",
        "db.go",
        "dispatches.go",
        "events.go",
        "identities.go",
        "leases.go",
        "manifests.go",
        "memberships.go",
        "migrate.go",
        "outbox.go",
        "provider_accounts.go",
        "receipts.go",
        "runs.go",
        "scope.go",
        "secrets.go",
        "settlements.go",
        "tasks.go",
        "transaction.go",
    ],
    embedsrcs = glob(["migrations/postgres/*.sql"]),
    importpath = "github.com/polymetrics-ai/pm-cli/internal/store",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/contract",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgconn",
