load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "auth",
    srcs = [
        "authorize.go",
        "browser.go",
        "device.go",
        "discovery.go",
        "grants.go",
        "identity.go",
        "oidc.go",
        "revocation.go",
        "service.go",
        "sessions.go",
    ],
    importpath = "github.com/polymetrics-ai/pm-cli/internal/auth",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/contract",
        "//internal/store",
        "@com_github_coreos_go_oidc_v3//oidc",
        "@org_golang_x_oauth2//:oauth2",
    ],
)

go_test(
    name = "auth_test",
    size = "large",
    srcs = [
        "authorize_test.go",
        "browser_test.go",
        "credential_ingress_test.go",
        "receipt_test.go",
        "service_test.go",
        "sessions_test.go",
        "test_helpers_test.go",
    ],
    embed = [":auth"],
    env_inherit = [
        "GOMAXPROCS",
        "GOMEMLIMIT",
        "PM_STORE_TEST_SECRETS_DIR",
    ],
    tags = ["exclusive", "external", "no-remote"],
    deps = [
        "//internal/app",
        "//internal/contract",
        "//internal/store",
        "@com_github_coreos_go_oidc_v3//oidc",
        "@com_github_jackc_pgx_v5//:pgx",
        "@org_golang_x_oauth2//:oauth2",
    ],
)
