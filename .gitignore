# Local navigation index; never source or proof authority.
/.codegraph/
/.codegraph-*/
# Local execution state and credentials belong outside the repository.
/.pm/
/.env
/.env.*
# Generated runtime bundles and connector declarations remain versioned.
/.proof/
/dist/
/coverage/
*.test
# Project-local tool/bootstrap and Bazel outputs; source BUILD files stay tracked.
/.cache/
/bazel-*
/tools/bazel-*
