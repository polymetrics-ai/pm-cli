{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.polymetrics.dev/pm/release-pair/v1",
  "title": "PM Release Pair",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "backend_architecture",
    "protocol_major",
    "required_features",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "pm.release-pair/v1"
    },
    "release_id": {
      "$ref": "#/$defs/releaseID"
    },
    "backend_architecture": {
      "const": "postgresql-temporal-s3"
    },
    "protocol_major": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "required_features": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "releaseID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^/\\\\]+(?:/[^/\\\\]+)*$",
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "role": {
      "enum": [
        "cli",
        "api",
        "worker",
        "query_helper",
        "public_schema",
        "server_config_schema",
        "stack_launcher",
        "server_config_example",
        "license",
        "notice",
        "image_lock",
        "connector_bundle",
        "migration"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "version",
        "sha256",
        "media_type",
        "executable",
        "platforms"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "executable": {
          "type": "boolean"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^(?:any|[a-z0-9]+-[a-z0-9_]+)$"
          }
        }
      }
    }
  }
}
