module(name = "pm_cli")

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

go_deps.module_override(
    patch_strip = 1,
    patches = ["//build/patches:duckdb-go-bindings.patch"],
    path = "github.com/duckdb/duckdb-go-bindings",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//build/patches:duckdb-go-bindings-static.patch"],
    path = "github.com/duckdb/duckdb-go-bindings/lib/darwin-arm64",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//build/patches:duckdb-go-bindings-static.patch"],
    path = "github.com/duckdb/duckdb-go-bindings/lib/linux-amd64",
)
go_deps.module_override(
    patch_strip = 1,
    patches = ["//build/patches:duckdb-go-bindings-static.patch"],
    path = "github.com/duckdb/duckdb-go-bindings/lib/linux-arm64",
)
use_repo(
    go_deps,
    "com_github_aws_aws_sdk_go_v2",
    "com_github_aws_aws_sdk_go_v2_service_s3",
    "com_github_aws_smithy_go",
    "com_github_coreos_go_oidc_v3",
    "com_github_duckdb_duckdb_go_bindings",
    "com_github_duckdb_duckdb_go_v2",
    "com_github_getkin_kin_openapi",
    "com_github_gin_gonic_gin",
    "com_github_jackc_pgx_v5",
    "com_github_oapi_codegen_nullable",
    "com_github_oapi_codegen_runtime",
    "com_github_pressly_goose_v3",
    "com_github_santhosh_tekuri_jsonschema_v6",
    "com_github_spf13_cobra",
    "com_github_testcontainers_testcontainers_go",
    "com_github_zalando_go_keyring",
    "in_yaml_go_yaml_v3",
    "io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp",
    "io_opentelemetry_go_otel",
    "io_opentelemetry_go_otel_exporters_otlp_otlpmetric_otlpmetrichttp",
    "io_opentelemetry_go_otel_exporters_otlp_otlptrace_otlptracehttp",
    "io_opentelemetry_go_otel_metric",
    "io_opentelemetry_go_otel_sdk",
    "io_opentelemetry_go_otel_sdk_metric",
    "io_opentelemetry_go_otel_trace",
    "io_temporal_go_api",
    "io_temporal_go_sdk",
    "org_golang_google_protobuf",
    "org_golang_x_oauth2",
    "org_golang_x_sync",
    "org_golang_x_time",
)

tools_go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps", isolate = True)
tools_go_deps.from_file(go_mod = "//tools:go.mod")
use_repo(
    tools_go_deps,
    tools_co_honnef_go_tools = "co_honnef_go_tools",
    tools_com_github_getkin_kin_openapi = "com_github_getkin_kin_openapi",
    tools_com_github_oapi_codegen_oapi_codegen_v2 = "com_github_oapi_codegen_oapi_codegen_v2",
    tools_in_yaml_go_yaml_v3 = "in_yaml_go_yaml_v3",
    tools_org_golang_x_vuln = "org_golang_x_vuln",
)
