{
  "schema_version": "pm.api.controls/v1",
  "wire_version": "pm.api/v1",
  "protocol_major": 1,
  "supported_features": [
    "exact-values",
    "metadata-only-replay",
    "typed-result-controls",
    "wire-problem-v1"
  ],
  "protocol_metadata": {
    "required": [
      "expected_revision",
      "intent_digest",
      "request_key",
      "required_features",
      "wire_version"
    ],
    "optional": []
  },
  "forbidden_public_fields": [
    "access_token",
    "api_key",
    "client_secret",
    "credential_value",
    "password",
    "pm_automation_credential",
    "provider_credential",
    "provider_secret",
    "refresh_token",
    "secret"
  ],
  "run_states": [
    "accepted",
    "awaiting_approval",
    "blocked",
    "cancelled",
    "failed",
    "partial",
    "queued",
    "reconciling",
    "running",
    "succeeded"
  ],
  "terminal_run_states": [
    "cancelled",
    "failed",
    "partial",
    "succeeded"
  ],
  "problems": [
    {
      "status": 400,
      "code": "invalid_request",
      "safe_retry_action": "correct_input",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 400,
      "code": "invalid_event_cursor",
      "safe_retry_action": "correct_input",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 401,
      "code": "authentication_required",
      "safe_retry_action": "refresh_authorization",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 403,
      "code": "grant_unavailable",
      "safe_retry_action": "refresh_authorization",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 404,
      "code": "resource_not_found",
      "safe_retry_action": "correct_scope",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 409,
      "code": "foundation_incompatible",
      "safe_retry_action": "after_capability_change",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 409,
      "code": "idempotency_conflict",
      "safe_retry_action": "new_key_for_new_intent",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 409,
      "code": "resume_unavailable",
      "safe_retry_action": "refresh_run_state",
      "disposition": "confirmed_refusal"
    },
    {
