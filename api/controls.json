      "disposition": "confirmed_refusal"
    },
    {
      "status": 503,
      "code": "deployment_admission_overload",
      "safe_retry_action": "after_backlog_progress",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 400,
      "code": "login_challenge_invalid",
      "safe_retry_action": "restart_login",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 401,
      "code": "oidc_verification_failed",
      "safe_retry_action": "restart_login",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 403,
      "code": "inbound_policy_rejected",
      "safe_retry_action": "use_trusted_transport",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 403,
      "code": "csrf_validation_failed",
      "safe_retry_action": "refresh_browser_session",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 403,
      "code": "device_authorization_denied",
      "safe_retry_action": "restart_login",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 403,
      "code": "reauthentication_required",
      "safe_retry_action": "reauthenticate",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 409,
      "code": "resource_conflict",
      "safe_retry_action": "inspect_existing_result",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 409,
      "code": "login_challenge_used",
      "safe_retry_action": "restart_login",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 409,
      "code": "device_authorization_pending",
      "safe_retry_action": "poll_after_interval",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 409,
      "code": "credential_revision_stale",
      "safe_retry_action": "refresh_control_revision",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 410,
      "code": "login_challenge_expired",
      "safe_retry_action": "restart_login",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 429,
      "code": "device_poll_too_soon",
      "safe_retry_action": "poll_after_interval",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 429,
      "code": "authentication_rate_limited",
      "safe_retry_action": "retry_after_backoff",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 500,
      "code": "internal_error",
      "safe_retry_action": "contact_support_with_incident_id",
      "disposition": "unclassified_failure"
    },
    {
      "status": 503,
      "code": "credential_storage_unavailable",
      "safe_retry_action": "after_capability_change",
      "disposition": "confirmed_refusal"
    },
    {
      "status": 503,
      "code": "mutation_outcome_unknown",
      "safe_retry_action": "same_key_reconcile_only",
