{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymetrics.ai/schemas/source.schema.json",
  "title": "PM immutable connector source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "connector_id",
    "source_set",
    "operations",
    "semantics_revision"
  ],
  "properties": {
    "schema_version": {"const": "pm.connector-source/v1"},
    "connector_id": {"$ref": "#/$defs/identity"},
    "source_set": {"$ref": "#/$defs/sourceSet"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceOperation"}
    },
    "semantics_revision": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(\\S|\\S.*\\S)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialect", "documents", "references_closed"],
      "properties": {
        "dialect": {
          "enum": ["openapi-3.0", "openapi-3.1", "swagger-2.0", "postgresql-official"]
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceDocument"}
        },
        "references_closed": {"const": true}
      }
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "dialect",
        "official_url",
        "path",
        "captured_at",
        "byte_length",
        "sha256",
        "license"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/identity"},
        "dialect": {
          "description": "The exact dialect of this document: the source set dialect for the one description that supplies operations (and for the declared fragments of its reference closure), or official-documentation for a supplemental capture that is never parsed as OpenAPI data and is addressable only by an exact byte range.",
          "enum": ["openapi-3.0", "openapi-3.1", "swagger-2.0", "official-documentation"]
        },
        "official_url": {"type": "string", "format": "uri", "maxLength": 4096},
        "repository": {"type": "string", "format": "uri", "maxLength": 4096},
        "revision": {"$ref": "#/$defs/identity"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "captured_at": {"type": "string", "format": "date-time"},
        "pointer": {"type": "string", "maxLength": 4096},
        "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "upstream_byte_length": {"type": "integer", "minimum": 0},
        "upstream_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_length": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "license": {"$ref": "#/$defs/license"},
        "references": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"}
        }
      },
      "dependentRequired": {
        "repository": ["revision"],
        "revision": ["repository"],
        "git_blob": ["repository", "revision", "upstream_byte_length", "upstream_sha256"],
        "upstream_byte_length": ["git_blob", "upstream_sha256"],
        "upstream_sha256": ["git_blob", "upstream_byte_length"]
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "path", "sha256", "notice_required"],
      "properties": {
        "spdx": {"$ref": "#/$defs/identity"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "copyright": {"type": "string", "maxLength": 4096},
        "notice_required": {"type": "boolean"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_pointer", "reference", "target_source_id", "target_pointer"],
      "properties": {
        "from_pointer": {"type": "string", "maxLength": 4096},
        "reference": {"type": "string", "minLength": 1, "maxLength": 4096},
        "target_source_id": {"$ref": "#/$defs/identity"},
        "target_pointer": {"type": "string", "maxLength": 4096}
      }
    },
    "sourceOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_operation_id", "source_refs", "request_variants", "response_variants"],
      "properties": {
        "source_operation_id": {"$ref": "#/$defs/identity"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "request_variants": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/variantRef"}
        },
        "response_variants": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/variantRef"}
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "pointer"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identity"},
        "pointer": {"type": "string", "maxLength": 4096}
      }
    },
    "variantRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "media_type"],
      "properties": {
        "pointer": {"type": "string", "maxLength": 4096},
        "status": {"type": "string", "pattern": "^([1-5][0-9][0-9]|default)$"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
