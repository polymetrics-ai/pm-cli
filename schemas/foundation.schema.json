{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymetrics.ai/schemas/foundation.schema.json",
  "title": "PM foundation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "name",
    "owner",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": "pm.foundation/v1"
    },
    "id": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^FND-0*[1-9][0-9]*$"
    },
    "version": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:\\S|\\S.*\\S)$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:\\S|\\S.*\\S)$"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/foundationRef"
      }
    }
  },
  "$defs": {
    "foundationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^FND-0*[1-9][0-9]*$"
        },
        "version": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    }
  }
}
