{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymetrics.ai/schemas/scenario.schema.json",
  "title": "PM connector qualification scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "connector_id",
    "lane",
    "operation_id",
    "source_refs",
    "requirements",
    "steps",
    "assertions",
    "cleanup"
  ],
  "properties": {
    "scenario_version": {"const": "pm.scenario/v1"},
    "scenario_id": {"$ref": "#/$defs/identity"},
    "connector_id": {"$ref": "#/$defs/identity"},
    "lane": {"$ref": "#/$defs/lane"},
    "operation_id": {"$ref": "#/$defs/identity"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceRef"}
    },
    "requirements": {
      "type": "array",
      "items": {"$ref": "#/$defs/requirement"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assertion"}
    },
    "cleanup": {"$ref": "#/$defs/cleanup"}
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(\\S|\\S.*\\S)$"
    },
    "lane": {
      "enum": [
        "direct_read",
        "direct_write",
        "etl",
        "reverse_etl",
        "binary_download",
        "binary_upload",
        "sync_transport"
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "pointer"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identity"},
        "pointer": {"type": "string", "maxLength": 4096}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "kind", "value"],
      "properties": {
        "requirement_id": {"$ref": "#/$defs/identity"},
        "kind": {"enum": ["capability", "fixture", "secret_reference", "foundation", "service"]},
        "value": {"$ref": "#/$defs/identity"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "kind", "depends_on", "action", "input", "captures"],
      "properties": {
        "step_id": {"$ref": "#/$defs/identity"},
        "kind": {"enum": ["setup", "invoke", "readback", "inspect", "cleanup"]},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identity"}
        },
        "action": {"$ref": "#/$defs/identity"},
        "input": {"$ref": "#/$defs/value"},
        "captures": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capture"}
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "pointer", "sensitivity"],
      "properties": {
        "name": {"$ref": "#/$defs/identity"},
        "pointer": {"type": "string", "pattern": "^(/([^~]|~[01])*)*$"},
        "sensitivity": {"enum": ["public", "secret_reference"]}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "step_id", "kind", "expected"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/identity"},
        "step_id": {"$ref": "#/$defs/identity"},
        "kind": {"enum": ["equals", "contains", "absent", "row", "effect", "sha256", "cursor_transition"]},
        "pointer": {"type": "string", "pattern": "^(/([^~]|~[01])*)*$"},
        "expected": {"$ref": "#/$defs/value"}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["always", "owned_id_captures", "steps"],
      "properties": {
        "always": {"const": true},
        "owned_id_captures": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identity"}
        },
        "steps": {
          "type": "array",
          "items": {"$ref": "#/$defs/step"}
        }
      }
    },
    "value": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/value"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}}
      ]
    }
  }
}
