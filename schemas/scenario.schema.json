{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymetrics.ai/schemas/scenario.schema.json",
  "title": "PM connector qualification scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "connector_id",
    "lane",
    "operation_id",
    "source_refs",
    "requirements",
    "steps",
    "assertions",
    "cleanup"
  ],
  "properties": {
    "scenario_version": {"const": "pm.scenario/v1"},
    "scenario_id": {"$ref": "#/$defs/identity"},
    "connector_id": {"$ref": "#/$defs/identity"},
    "lane": {"$ref": "#/$defs/lane"},
    "operation_id": {"$ref": "#/$defs/identity"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceRef"}
    },
    "requirements": {
      "type": "array",
      "items": {"$ref": "#/$defs/requirement"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assertion"}
    },
    "cleanup": {"$ref": "#/$defs/cleanup"}
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(\\S|\\S.*\\S)$"
    },
    "lane": {
      "enum": [
        "direct_read",
        "direct_write",
        "etl",
        "reverse_etl",
        "binary_download",
        "binary_upload",
        "sync_transport"
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "pointer"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identity"},
        "pointer": {"type": "string", "maxLength": 4096}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "kind", "value"],
      "properties": {
        "requirement_id": {"$ref": "#/$defs/identity"},
        "kind": {"enum": ["capability", "fixture", "secret_reference", "foundation", "service"]},
        "value": {"$ref": "#/$defs/identity"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "kind", "depends_on", "action", "input", "captures"],
      "properties": {
        "step_id": {"$ref": "#/$defs/identity"},
        "kind": {"enum": ["setup", "invoke", "readback", "inspect", "cleanup"]},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identity"}
        },
        "action": {"$ref": "#/$defs/identity"},
        "input": {"$ref": "#/$defs/value"},
        "captures": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capture"}
        },
        "input_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/inputBinding"}
        },
        "connection_ref": {"$ref": "#/$defs/identity"},
        "result_controls": {"$ref": "#/$defs/resultControls"}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "pointer", "sensitivity"],
      "properties": {
        "name": {"$ref": "#/$defs/identity"},
        "pointer": {"type": "string", "pattern": "^(/([^~]|~[01])*)*$"},
        "sensitivity": {"enum": ["public", "secret_reference"]}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "step_id", "kind", "expected"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/identity"},
        "step_id": {"$ref": "#/$defs/identity"},
        "kind": {"enum": ["equals", "contains", "absent", "row", "effect", "sha256", "cursor_transition"]},
        "pointer": {"type": "string", "pattern": "^(/([^~]|~[01])*)*$"},
        "expected": {"$ref": "#/$defs/value"}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["always", "owned_id_captures", "steps"],
      "properties": {
        "always": {"const": true},
        "owned_id_captures": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identity"}
        },
        "steps": {
          "type": "array",
          "items": {"$ref": "#/$defs/step"}
        }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "capture"],
      "properties": {
        "pointer": {"type": "string", "maxLength": 4096, "pattern": "^(/([^~]|~[01])*)*$"},
        "capture": {"$ref": "#/$defs/identity"}
      }
    },
    "resultControls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selection": {"$ref": "#/$defs/fieldSelection"},
        "filter": {"$ref": "#/$defs/recordFilter"},
        "total_record_cap": {"type": "integer", "minimum": 1},
        "continuation": {"$ref": "#/$defs/presentValue"}
      }
    },
    "fieldSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        }
      }
    },
    "recordFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator"],
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "operator": {"enum": ["equal", "is_absent", "is_null"]},
        "value": {"$ref": "#/$defs/presentValue"}
      },
      "allOf": [
        {
          "if": {"properties": {"operator": {"const": "equal"}}},
          "then": {
            "required": ["value"],
            "properties": {
              "value": {
                "not": {
                  "type": "object",
                  "required": ["presence"],
                  "properties": {"presence": {"const": "absent"}}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"operator": {"enum": ["is_absent", "is_null"]}}},
          "then": {"not": {"required": ["value"]}}
        }
      ]
    },
    "presentValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["presence"],
          "properties": {"presence": {"const": "absent"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["presence"],
          "properties": {"presence": {"const": "null"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["presence", "type", "text"],
          "properties": {
            "presence": {"const": "value"},
            "type": {"enum": ["string", "date", "timestamp_instant", "timestamp_local"]},
            "text": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["presence", "type", "boolean"],
          "properties": {
            "presence": {"const": "value"},
            "type": {"const": "bool"},
            "boolean": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["presence", "type", "exact", "precision", "scale"],
          "properties": {
            "presence": {"const": "value"},
            "type": {"enum": ["integer", "decimal"]},
            "exact": {"type": "string"},
            "precision": {"type": "integer", "minimum": 1},
            "scale": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["presence", "type", "elements"],
          "properties": {
            "presence": {"const": "value"},
            "type": {"const": "array"},
            "elements": {"type": "array", "items": {"$ref": "#/$defs/presentValue"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["presence", "type", "fields"],
          "properties": {
            "presence": {"const": "value"},
            "type": {"const": "object"},
            "fields": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/presentValue"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["presence", "type", "variant", "member"],
          "properties": {
            "presence": {"const": "value"},
            "type": {"const": "union"},
            "variant": {"type": "string", "minLength": 1},
            "member": {"$ref": "#/$defs/presentValue"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["presence", "type", "binary"],
          "properties": {
            "presence": {"const": "value"},
            "type": {"const": "binary_ref"},
            "binary": {"$ref": "#/$defs/objectRef"}
          }
        }
      ]
    },
    "objectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "org_id",
        "workspace_id",
        "artifact_id",
        "object_attempt_key",
        "sha256",
        "byte_length",
        "media_type",
        "backend_generation"
      ],
      "properties": {
        "org_id": {"type": "string", "minLength": 1},
        "workspace_id": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "object_attempt_key": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_length": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1},
        "backend_generation": {"type": "string", "minLength": 1}
      }
    },
    "value": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/value"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}}
      ]
    }
  }
}
