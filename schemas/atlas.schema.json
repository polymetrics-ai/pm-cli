{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymetrics.ai/schemas/atlas.schema.json",
  "title": "PM foundation gap atlas",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gaps"],
  "properties": {
    "schema_version": {"const": "pm.foundation-gap-atlas/v1"},
    "gaps": {
      "type": "array",
      "items": {"$ref": "#/$defs/foundationGap"}
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(\\S|\\S.*\\S)$"
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "pointer"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identity"},
        "pointer": {"type": "string", "maxLength": 4096}
      }
    },
    "foundationGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "semantic_signature",
        "source_refs",
        "field_or_operation_bindings",
        "required_contract",
        "affected_cells",
        "reason",
        "proposed_owner",
        "causal_test"
      ],
      "properties": {
        "gap_id": {"$ref": "#/$defs/identity"},
        "semantic_signature": {"$ref": "#/$defs/semanticSignature"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "field_or_operation_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/binding"}
        },
        "required_contract": {"$ref": "#/$defs/requiredContract"},
        "affected_cells": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/affectedCell"}
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 8192},
        "proposed_owner": {"$ref": "#/$defs/proposedOwner"},
        "causal_test": {"$ref": "#/$defs/causalTest"}
      }
    },
    "semanticSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "behavior", "input_shape", "result_shape"],
      "properties": {
        "transport": {"enum": ["http", "postgresql", "binary", "sync"]},
        "behavior": {"$ref": "#/$defs/identity"},
        "input_shape": {"$ref": "#/$defs/identity"},
        "result_shape": {"$ref": "#/$defs/identity"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector_id", "operation_id", "binding_kind", "binding_id"],
      "properties": {
        "connector_id": {"$ref": "#/$defs/identity"},
        "operation_id": {"$ref": "#/$defs/identity"},
        "binding_kind": {"enum": ["field", "operation"]},
        "binding_id": {"$ref": "#/$defs/identity"}
      }
    },
    "requiredContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "versioning"],
      "properties": {
        "kind": {"enum": ["foundation_extension", "versioned_foundation", "bounded_native_adapter"]},
        "name": {"$ref": "#/$defs/identity"},
        "versioning": {"enum": ["compatible_extension", "new_version"]},
        "contract": {"type": "string", "maxLength": 16384}
      }
    },
    "affectedCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector_id", "lane", "behavior_id"],
      "properties": {
        "connector_id": {"$ref": "#/$defs/identity"},
        "lane": {
          "enum": [
            "direct_read",
            "direct_write",
            "etl",
            "reverse_etl",
            "binary_download",
            "binary_upload",
            "sync_transport"
          ]
        },
        "behavior_id": {"$ref": "#/$defs/identity"}
      }
    },
    "proposedOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "component"],
      "properties": {
        "issue": {"$ref": "#/$defs/identity"},
        "component": {"$ref": "#/$defs/identity"}
      }
    },
    "causalTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "fixture", "variation", "observable"],
      "properties": {
        "test_id": {"$ref": "#/$defs/identity"},
        "fixture": {"type": "string", "minLength": 1, "maxLength": 8192},
        "variation": {"type": "string", "minLength": 1, "maxLength": 8192},
        "observable": {"type": "string", "minLength": 1, "maxLength": 8192}
      }
    }
  }
}
