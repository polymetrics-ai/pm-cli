{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymetrics.ai/schemas/bundle.schema.json",
  "title": "PM immutable connector bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "connector_id",
    "source_digest",
    "semantics_revision",
    "operations",
    "commands",
    "unavailable_operations"
  ],
  "properties": {
    "schema_version": {"const": "pm.bundle/v1"},
    "connector_id": {"$ref": "#/$defs/identity"},
    "source_digest": {"$ref": "#/$defs/digest"},
    "semantics_revision": {"$ref": "#/$defs/digest"},
    "operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/typedOperation"}
    },
    "commands": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/command"}
    },
    "unavailable_operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/unavailableOperation"}
    }
  },
  "allOf": [
    {
      "anyOf": [
        {"properties": {"operations": {"minItems": 1}}},
        {"properties": {"unavailable_operations": {"minItems": 1}}}
      ]
    }
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(\\S|\\S.*\\S)$"
    },
    "contractIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(\\S|\\S.*\\S)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "pointer"],
      "properties": {
        "source_id": {"$ref": "#/$defs/contractIdentity"},
        "pointer": {"type": "string", "maxLength": 4096, "pattern": "^(?:#(?:/(?:[^~]|~[01])*)?|/(?:[^~]|~[01])*)$"}
      }
    },
    "operationExecution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http": {"$ref": "#/$defs/operationHTTP"},
        "pagination": {"$ref": "#/$defs/operationPagination"},
        "retry": {"$ref": "#/$defs/operationRetry"}
      },
      "anyOf": [
        {"required": ["http"]},
        {"required": ["pagination"]},
        {"required": ["retry"]}
      ]
    },
    "operationHTTP": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origins", "witness"],
      "properties": {
        "origins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^https?://"}
        },
        "authorization": {"$ref": "#/$defs/operationAuthorization"},
        "headers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/operationHTTPHeader"}
        },
        "witness": {"$ref": "#/$defs/executionWitness"}
      }
    },
    "operationHTTPHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"},
        "value": {"type": "string", "maxLength": 8192}
      }
    },
    "operationAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "audience", "placement", "wire_name", "prefix", "field_id"],
      "properties": {
        "required": {"type": "boolean"},
        "audience": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^https?://"},
        "placement": {"enum": ["header", "query", "cookie"]},
        "wire_name": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"},
        "prefix": {"type": "string", "maxLength": 1024},
        "field_id": {"$ref": "#/$defs/contractIdentity"}
      }
    },
    "executionWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_id", "source_refs"],
      "properties": {
        "proof_id": {"$ref": "#/$defs/identity"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceRef"}
        }
      }
    },
    "operationPagination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "cursor_request_field", "cursor_response_pointer", "witness"],
          "properties": {
            "kind": {"const": "cursor"},
            "cursor_request_field": {"$ref": "#/$defs/contractIdentity"},
            "cursor_response_pointer": {"$ref": "#/$defs/nonRootJSONPointer"},
            "witness": {"$ref": "#/$defs/executionWitness"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "offset_request_field", "limit_request_field", "witness"],
          "properties": {
            "kind": {"const": "offset"},
            "offset_request_field": {"$ref": "#/$defs/contractIdentity"},
            "limit_request_field": {"$ref": "#/$defs/contractIdentity"},
            "total_response_pointer": {"$ref": "#/$defs/nonRootJSONPointer"},
            "witness": {"$ref": "#/$defs/executionWitness"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "page_request_field", "witness"],
          "properties": {
            "kind": {"const": "page"},
            "page_request_field": {"$ref": "#/$defs/contractIdentity"},
            "last_page_response_pointer": {"$ref": "#/$defs/nonRootJSONPointer"},
            "witness": {"$ref": "#/$defs/executionWitness"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "link_request_field", "link_response_header", "witness"],
          "properties": {
            "kind": {"const": "link"},
            "link_request_field": {"$ref": "#/$defs/contractIdentity"},
            "link_response_header": {"type": "string", "pattern": "^[Ll][Ii][Nn][Kk]$"},
            "limit_request_field": {"$ref": "#/$defs/contractIdentity"},
            "witness": {"$ref": "#/$defs/executionWitness"}
          }
        }
      ]
    },
    "operationRetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "witness"],
      "properties": {
        "classification": {"enum": ["unsafe", "safe", "conditional"]},
        "condition": {"$ref": "#/$defs/identity"},
        "http_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 400, "maximum": 599}
        },
        "witness": {"$ref": "#/$defs/executionWitness"}
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"const": "conditional"}}},
          "then": {"required": ["condition"]},
          "else": {"not": {"required": ["condition"]}}
        }
      ]
    },
    "nonRootJSONPointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?:[^~]|~[01])*$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "operation_id", "fields"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S+$"},
        "operation_id": {"$ref": "#/$defs/contractIdentity"},
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/commandField"}
        }
      }
    },
    "commandField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flag", "field_id", "location", "required", "sensitive"],
      "properties": {
        "flag": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^--[^\\s=]+$"},
        "field_id": {"$ref": "#/$defs/contractIdentity"},
        "location": {"enum": ["path", "query", "header", "cookie", "body", "record", "metadata"]},
        "required": {"type": "boolean"},
        "sensitive": {"type": "boolean"}
      }
    },
    "unavailableOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "source_refs", "diagnostic_codes", "lane_eligibility"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/contractIdentity"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "diagnostic_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S+$"}
        },
        "lane_eligibility": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/unavailableLaneEligibility"},
          "allOf": [
            {"contains": {"properties": {"lane": {"const": "direct_read"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "direct_write"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "etl"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "reverse_etl"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "binary_download"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "binary_upload"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "sync_transport"}}}, "minContains": 1, "maxContains": 1}
          ]
        }
      }
    },
    "unavailableLaneEligibility": {
      "allOf": [
        {"$ref": "#/$defs/laneEligibility"},
        {"properties": {"status": {"enum": ["unsupported", "not_applicable", "blocked", "unproven"]}}}
      ]
    },
    "typedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_id",
        "source_refs",
        "transport",
        "inputs",
        "request_variants",
        "responses",
        "capability_requirements",
        "lane_eligibility"
      ],
      "properties": {
        "schema_version": {"const": "pm.operation/v1"},
        "operation_id": {"$ref": "#/$defs/contractIdentity"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "transport": {"$ref": "#/$defs/transport"},
        "inputs": {
          "type": "array",
          "items": {"$ref": "https://polymetrics.ai/schemas/field-binding.schema.json#/$defs/fieldBinding"}
        },
        "request_variants": {
          "type": "array",
          "items": {"$ref": "#/$defs/requestVariant"}
        },
        "request_media_field_id": {"$ref": "#/$defs/contractIdentity"},
        "execution": {"$ref": "#/$defs/operationExecution"},
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/responseVariant"}
        },
        "capability_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/capabilityRequirement"}
        },
        "lane_eligibility": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/laneEligibility"},
          "allOf": [
            {"contains": {"properties": {"lane": {"const": "direct_read"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "direct_write"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "etl"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "reverse_etl"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "binary_download"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "binary_upload"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "sync_transport"}}}, "minContains": 1, "maxContains": 1}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"request_variants": {"minItems": 2}}},
          "then": {"required": ["request_media_field_id"]},
          "else": {"not": {"required": ["request_media_field_id"]}}
        },
        {
          "if": {
            "properties": {
              "transport": {
                "properties": {"kind": {"const": "postgresql"}}
              }
            }
          },
          "then": {
            "properties": {
              "responses": {
                "items": {
                  "properties": {
                    "status": {"const": "success"},
                    "no_content": {"const": false}
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "responses": {
                "items": {
                  "properties": {
                    "status": {"pattern": "^([1-5][0-9][0-9]|default)$"}
                  }
                }
              }
            }
          }
        },
        {
          "if": {"required": ["execution"]},
          "then": {
            "properties": {
              "transport": {
                "properties": {"kind": {"const": "http"}}
              }
            }
          }
        }
      ]
    },
    "requestVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_id", "media_type", "required", "schema", "inputs", "source_refs"],
      "properties": {
        "variant_id": {"$ref": "#/$defs/contractIdentity"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 512},
        "required": {"type": "boolean"},
        "schema": {"$ref": "https://polymetrics.ai/schemas/field-binding.schema.json#/$defs/schema"},
        "inputs": {
          "type": "array",
          "items": {"$ref": "https://polymetrics.ai/schemas/field-binding.schema.json#/$defs/fieldBinding"}
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceRef"}
        }
      }
    },
    "capabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "foundation"],
      "properties": {
        "capability": {"$ref": "#/$defs/contractIdentity"},
        "foundation": {"$ref": "https://polymetrics.ai/schemas/foundation.schema.json#/$defs/foundationRef"}
      }
    },
    "transport": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "method", "path"],
          "properties": {
            "kind": {"const": "http"},
            "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]},
            "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "statement_kind", "relation_binding"],
          "properties": {
            "kind": {"const": "postgresql"},
            "statement_kind": {"enum": ["metadata", "select", "mapped_upsert"]},
            "relation_binding": {"$ref": "#/$defs/contractIdentity"}
          }
        }
      ]
    },
    "responseVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "no_content", "source_refs"],
      "properties": {
        "status": {"type": "string", "minLength": 1, "maxLength": 512},
        "no_content": {"type": "boolean"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 512},
        "schema": {"$ref": "https://polymetrics.ai/schemas/field-binding.schema.json#/$defs/schema"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "record_pointer": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?:/(?:[^~]|~[01])*)?$"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"no_content": {"const": true}}},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["media_type"]},
                {"required": ["schema"]},
                {"required": ["record_pointer"]}
              ]
            }
          },
          "else": {"required": ["media_type", "schema"]}
        }
      ]
    },
    "laneEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "status", "reason"],
      "properties": {
        "lane": {
          "enum": [
            "direct_read",
            "direct_write",
            "etl",
            "reverse_etl",
            "binary_download",
            "binary_upload",
            "sync_transport"
          ]
        },
        "status": {"enum": ["eligible", "unsupported", "not_applicable", "blocked", "unproven"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(\\S|\\S.*\\S)$"}
      }
    }
  }
}
