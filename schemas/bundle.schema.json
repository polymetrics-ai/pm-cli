{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymetrics.ai/schemas/bundle.schema.json",
  "title": "PM immutable connector bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "connector_id",
    "source_digest",
    "semantics_revision",
    "operations"
  ],
  "properties": {
    "schema_version": {"const": "pm.bundle/v1"},
    "connector_id": {"$ref": "#/$defs/identity"},
    "source_digest": {"$ref": "#/$defs/digest"},
    "semantics_revision": {"$ref": "#/$defs/digest"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/typedOperation"}
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(\\S|\\S.*\\S)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "pointer"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identity"},
        "pointer": {"type": "string", "maxLength": 4096}
      }
    },
    "typedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "source_refs",
        "transport",
        "inputs",
        "responses",
        "capability_requirements",
        "lane_eligibility"
      ],
      "properties": {
        "operation_id": {"$ref": "#/$defs/identity"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "transport": {"$ref": "#/$defs/transport"},
        "inputs": {
          "type": "array",
          "items": {"$ref": "https://polymetrics.ai/schemas/field-binding.schema.json#/$defs/fieldBinding"}
        },
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/responseVariant"}
        },
        "capability_requirements": {
          "type": "array",
          "items": {"$ref": "https://polymetrics.ai/schemas/foundation.schema.json#/$defs/foundationRef"}
        },
        "lane_eligibility": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/laneEligibility"},
          "allOf": [
            {"contains": {"properties": {"lane": {"const": "direct_read"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "direct_write"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "etl"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "reverse_etl"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "binary_download"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "binary_upload"}}}, "minContains": 1, "maxContains": 1},
            {"contains": {"properties": {"lane": {"const": "sync_transport"}}}, "minContains": 1, "maxContains": 1}
          ]
        }
      }
    },
    "transport": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "method", "path"],
          "properties": {
            "kind": {"const": "http"},
            "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]},
            "path": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "statement_kind", "relation_binding"],
          "properties": {
            "kind": {"const": "postgresql"},
            "statement_kind": {"enum": ["metadata", "select", "mapped_upsert"]},
            "relation_binding": {"$ref": "#/$defs/identity"}
          }
        }
      ]
    },
    "responseVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "media_type", "schema", "source_refs"],
      "properties": {
        "status": {"type": "string", "pattern": "^([1-5][0-9][0-9]|default)$"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 512},
        "schema": {"$ref": "https://polymetrics.ai/schemas/field-binding.schema.json#/$defs/schema"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "record_pointer": {"type": "string", "maxLength": 4096}
      }
    },
    "laneEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "status", "reason"],
      "properties": {
        "lane": {
          "enum": [
            "direct_read",
            "direct_write",
            "etl",
            "reverse_etl",
            "binary_download",
            "binary_upload",
            "sync_transport"
          ]
        },
        "status": {"enum": ["eligible", "unsupported", "not_applicable", "blocked", "unproven"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
