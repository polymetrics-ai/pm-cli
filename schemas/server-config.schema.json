{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.polymetrics.dev/pm/server-config/v1",
  "title": "PM Server Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "public_origin",
    "postgres",
    "temporal",
    "artifacts",
    "identity",
    "encryption",
    "admission",
    "limits"
  ],
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listen": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "description": "Literal IPv4 or bracketed IPv6 address and nonzero TCP port; defaults to loopback."
        },
        "trusted_proxies": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2, "maxLength": 128},
          "description": "Explicit IP addresses or canonical CIDRs; no default trust or all-address prefix."
        },
        "read_header_timeout": {"$ref": "#/$defs/duration"},
        "request_timeout": {"$ref": "#/$defs/duration"},
        "write_timeout": {"$ref": "#/$defs/duration"},
        "idle_timeout": {"$ref": "#/$defs/duration"},
        "drain_timeout": {"$ref": "#/$defs/duration"},
        "probe_timeout": {"$ref": "#/$defs/duration"},
        "max_header_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_connections": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional for API-only configuration; pm-worker requires the complete block. Go validation enforces finite timeouts, timeout ordering, run-lifetime bounds, and membership of pm-control in temporal.task_queues.",
      "required": [
        "task_queue",
        "dial_timeout",
        "drain_timeout",
        "max_concurrent_activities",
        "max_concurrent_workflow_tasks",
        "activity_timeouts"
      ],
      "properties": {
        "task_queue": {"const": "pm-control"},
        "dial_timeout": {"$ref": "#/$defs/duration"},
        "drain_timeout": {"$ref": "#/$defs/duration"},
        "max_concurrent_activities": {"type": "integer", "minimum": 1, "maximum": 65536},
        "max_concurrent_workflow_tasks": {"type": "integer", "minimum": 1, "maximum": 65536},
        "activity_timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schedule_to_close", "start_to_close", "heartbeat", "transport"],
          "properties": {
            "schedule_to_close": {"$ref": "#/$defs/duration"},
            "start_to_close": {"$ref": "#/$defs/duration"},
            "heartbeat": {"$ref": "#/$defs/duration"},
            "transport": {"$ref": "#/$defs/duration"}
          }
        }
      }
    },
    "provider_http": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional complete server-owned HTTP execution policy. Absence grants no provider HTTP authority. Every destination is selected only by its exact organization, workspace, and connection binding; Go validation rejects duplicate bindings and validates each HTTPS source-style base URL. The optional tls_trust_root_ref names the operator secret bundle holding the provider egress trust root ca.pem; Go loads it at process startup and refuses a missing, empty, oversized, or unparsable root. Absence keeps the process system root store.",
      "required": [
        "max_request_bytes",
        "max_response_bytes",
        "max_dns_answers",
        "max_attempts",
        "max_retry_delay",
        "destinations"
      ],
      "properties": {
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775806
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775806
        },
        "max_dns_answers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "max_retry_delay": {
          "$ref": "#/$defs/positiveDuration"
        },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["org_id", "workspace_id", "connection_id", "origin"],
            "properties": {
              "org_id": {"$ref": "#/$defs/contractIdentity"},
              "workspace_id": {"$ref": "#/$defs/contractIdentity"},
              "connection_id": {"$ref": "#/$defs/contractIdentity"},
              "origin": {"$ref": "#/$defs/httpsBaseURL"}
            }
          }
        },
        "tls_trust_root_ref": {
          "$ref": "#/$defs/secretReference"
        }
      }
    },
    "connectors": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional declaration of the generated execution bundles this deployment admits. The object is complete or absent; absence and an empty array both install no connector and therefore claim no bundled capability. Every path is absolute, canonical, unique, and read as a bounded regular file at process startup; an unreadable, oversized, undecodable, or duplicate-connector bundle fails composition instead of degrading to a smaller catalog.",
      "required": ["bundles"],
      "properties": {
        "bundles": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/[^\\x00-\\x1f]*$"
          }
        }
      }
    },
    "schema_version": {
      "const": "1"
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "public_origin": {
      "$ref": "#/$defs/httpsOrigin"
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownership", "database", "endpoint_ref"],
      "properties": {
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "database": {
          "const": "pm_app"
        },
        "endpoint_ref": {
          "$ref": "#/$defs/secretReference"
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership",
        "endpoint",
        "namespace",
        "client_identity_ref",
        "retention",
        "task_queues"
      ],
      "properties": {
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "endpoint": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^(?:\\[[0-9A-Fa-f:]+\\]|[A-Za-z0-9.-]+):[1-9][0-9]{0,4}$"
        },
        "namespace": {
          "$ref": "#/$defs/identifier"
        },
        "client_identity_ref": {
          "$ref": "#/$defs/secretReference"
        },
        "retention": {
          "$ref": "#/$defs/duration"
        },
        "task_queues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership",
        "driver",
        "endpoint",
        "bucket",
        "credential_ref",
        "attempt_key_policy"
      ],
      "properties": {
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "driver": {
          "const": "s3"
        },
        "endpoint": {
          "$ref": "#/$defs/httpsURL"
        },
        "bucket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9.-]+$"
        },
        "credential_ref": {
          "$ref": "#/$defs/secretReference"
        },
        "attempt_key_policy": {
          "const": "unique_immutable"
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional complete artifact-byte execution policy. Absence leaves byte publication and reads unavailable. Go validation enforces the byte and retained-attempt hierarchies, the signed product bound, and the five-minute request-timeout ceiling.",
          "required": [
            "region",
            "max_object_bytes",
            "max_in_flight",
            "request_timeout",
            "organization_reserved_bytes",
            "workspace_reserved_bytes",
            "organization_reserved_attempts",
            "workspace_reserved_attempts"
          ],
          "properties": {
            "region": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9-]+$"
            },
            "max_object_bytes": {
              "$ref": "#/$defs/positiveInteger",
              "maximum": 9223372036854775806
            },
            "max_in_flight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "request_timeout": {
              "$ref": "#/$defs/duration"
            },
            "organization_reserved_bytes": {
              "$ref": "#/$defs/positiveInteger"
            },
            "workspace_reserved_bytes": {
              "$ref": "#/$defs/positiveInteger"
            },
            "organization_reserved_attempts": {
              "$ref": "#/$defs/positiveInteger"
            },
            "workspace_reserved_attempts": {
              "$ref": "#/$defs/positiveInteger"
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "client_id", "client_secret_ref"],
      "properties": {
        "issuer": {
          "$ref": "#/$defs/httpsURL"
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "[^ -~]"
          },
          "description": "OAuth client identifier retained verbatim under RFC 6749 section 2.2 and Appendix A.1; the configuration document byte limit still applies."
        },
        "client_secret_ref": {
          "$ref": "#/$defs/secretReference"
        },
        "step_up_maximum_age": {
          "$ref": "#/$defs/duration",
          "default": "5m",
          "description": "Maximum age of a verified signed OIDC auth_time for privileged secret ingress; 1s through 15m. Login/session issuance time never qualifies."
        }
      }
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wrapping_key_ref"],
      "properties": {
        "wrapping_key_ref": {
          "$ref": "#/$defs/secretReference"
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {
          "enum": ["development", "standard"]
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "global_pending": {
              "$ref": "#/$defs/positiveInteger"
            },
            "workspace_pending": {
              "$ref": "#/$defs/positiveInteger"
            },
            "workspace_max_pending_age": {
              "$ref": "#/$defs/duration"
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_active_runs",
        "workflow_payload_bytes",
        "workflow_fanout",
        "run_lifetime",
        "event_buffer",
        "query_children",
        "query_child_memory_bytes",
        "query_child_deadline",
        "request_bytes",
        "metadata_deadline"
      ],
      "properties": {
        "workspace_active_runs": {
          "$ref": "#/$defs/positiveInteger"
        },
        "workflow_payload_bytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "workflow_fanout": {
          "$ref": "#/$defs/positiveInteger"
        },
        "run_lifetime": {
          "$ref": "#/$defs/duration"
        },
        "event_buffer": {
          "$ref": "#/$defs/positiveInteger"
        },
        "query_children": {
          "$ref": "#/$defs/positiveInteger"
        },
        "query_child_memory_bytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "query_child_deadline": {
          "$ref": "#/$defs/duration"
        },
        "request_bytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "metadata_deadline": {
          "$ref": "#/$defs/duration"
        }
      }
    }
  },
  "$defs": {
    "ownership": {
      "enum": ["bundled", "managed"]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "contractIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:\\S|\\S.*\\S)$"
    },
    "secretReference": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2048,
      "pattern": "^secret://[^/?#@]+/[^?#]+$"
    },
    "httpsOrigin": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "format": "uri",
      "pattern": "^https://[^/?#@]+/?$"
    },
    "httpsURL": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "format": "uri",
      "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
    },
    "httpsBaseURL": {
      "type": "string",
      "minLength": 9,
      "maxLength": 4096,
      "format": "uri",
      "pattern": "^https://[^/?#@{}\\s]+(?:/[^?#{}\\s]*)?$"
    },
    "duration": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ns|us|µs|ms|s|m|h))+$"
    },
    "positiveDuration": {
      "allOf": [
        {"$ref": "#/$defs/duration"},
        {"not": {"pattern": "^(?:0+(?:\\.0+)?(?:ns|us|µs|ms|s|m|h))+$"}}
      ]
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  }
}
