{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.polymetrics.dev/pm/server-config/v1",
  "title": "PM Server Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "public_origin",
    "postgres",
    "temporal",
    "artifacts",
    "identity",
    "encryption",
    "admission",
    "limits"
  ],
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listen": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "description": "Literal IPv4 or bracketed IPv6 address and nonzero TCP port; defaults to loopback."
        },
        "trusted_proxies": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2, "maxLength": 128},
          "description": "Explicit IP addresses or canonical CIDRs; no default trust or all-address prefix."
        },
        "read_header_timeout": {"$ref": "#/$defs/duration"},
        "request_timeout": {"$ref": "#/$defs/duration"},
        "write_timeout": {"$ref": "#/$defs/duration"},
        "idle_timeout": {"$ref": "#/$defs/duration"},
        "drain_timeout": {"$ref": "#/$defs/duration"},
        "probe_timeout": {"$ref": "#/$defs/duration"},
        "max_header_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_connections": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    },
    "schema_version": {
      "const": "1"
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "public_origin": {
      "$ref": "#/$defs/httpsOrigin"
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownership", "database", "endpoint_ref"],
      "properties": {
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "database": {
          "const": "pm_app"
        },
        "endpoint_ref": {
          "$ref": "#/$defs/secretReference"
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership",
        "endpoint",
        "namespace",
        "client_identity_ref",
        "retention",
        "task_queues"
      ],
      "properties": {
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "endpoint": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^(?:\\[[0-9A-Fa-f:]+\\]|[A-Za-z0-9.-]+):[1-9][0-9]{0,4}$"
        },
        "namespace": {
          "$ref": "#/$defs/identifier"
        },
        "client_identity_ref": {
          "$ref": "#/$defs/secretReference"
        },
        "retention": {
          "$ref": "#/$defs/duration"
        },
        "task_queues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership",
        "driver",
        "endpoint",
        "bucket",
        "credential_ref",
        "attempt_key_policy"
      ],
      "properties": {
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "driver": {
          "const": "s3"
        },
        "endpoint": {
          "$ref": "#/$defs/httpsURL"
        },
        "bucket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9.-]+$"
        },
        "credential_ref": {
          "$ref": "#/$defs/secretReference"
        },
        "attempt_key_policy": {
          "const": "unique_immutable"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "client_id", "client_secret_ref"],
      "properties": {
        "issuer": {
          "$ref": "#/$defs/httpsURL"
        },
        "client_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "[^ -~]"
          },
          "description": "OAuth client identifier retained verbatim under RFC 6749 section 2.2 and Appendix A.1; the configuration document byte limit still applies."
        },
        "client_secret_ref": {
          "$ref": "#/$defs/secretReference"
        },
        "step_up_maximum_age": {
          "$ref": "#/$defs/duration",
          "default": "5m",
          "description": "Maximum age of a verified signed OIDC auth_time for privileged secret ingress; 1s through 15m. Login/session issuance time never qualifies."
        }
      }
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wrapping_key_ref"],
      "properties": {
        "wrapping_key_ref": {
          "$ref": "#/$defs/secretReference"
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {
          "enum": ["development", "standard"]
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "global_pending": {
              "$ref": "#/$defs/positiveInteger"
            },
            "workspace_pending": {
              "$ref": "#/$defs/positiveInteger"
            },
            "workspace_max_pending_age": {
              "$ref": "#/$defs/duration"
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_active_runs",
        "workflow_payload_bytes",
        "workflow_fanout",
        "run_lifetime",
        "event_buffer",
        "query_children",
        "query_child_memory_bytes",
        "query_child_deadline",
        "request_bytes",
        "metadata_deadline"
      ],
      "properties": {
        "workspace_active_runs": {
          "$ref": "#/$defs/positiveInteger"
        },
        "workflow_payload_bytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "workflow_fanout": {
          "$ref": "#/$defs/positiveInteger"
        },
        "run_lifetime": {
          "$ref": "#/$defs/duration"
        },
        "event_buffer": {
          "$ref": "#/$defs/positiveInteger"
        },
        "query_children": {
          "$ref": "#/$defs/positiveInteger"
        },
        "query_child_memory_bytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "query_child_deadline": {
          "$ref": "#/$defs/duration"
        },
        "request_bytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "metadata_deadline": {
          "$ref": "#/$defs/duration"
        }
      }
    }
  },
  "$defs": {
    "ownership": {
      "enum": ["bundled", "managed"]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "secretReference": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2048,
      "pattern": "^secret://[^/?#@]+/[^?#]+$"
    },
    "httpsOrigin": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "format": "uri",
      "pattern": "^https://[^/?#@]+/?$"
    },
    "httpsURL": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "format": "uri",
      "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
    },
    "duration": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ns|us|µs|ms|s|m|h))+$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  }
}
