{
  "name": "@polymetrics-ai/pm-browser",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "generate": "openapi-typescript ../../api/pm.openapi.json --output schema.d.ts",
    "generate:check": "openapi-typescript ../../api/pm.openapi.json --output ../../.cache/browser-schema.d.ts && cmp schema.d.ts ../../.cache/browser-schema.d.ts",
    "build": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
