load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "stack_test",
    size = "large",
    srcs = [
        "config_test.go",
        "storage_qualification_test.go",
    ],
    data = [
        "//:packaging/install-manifest.schema.json",
        "//:packaging/release-pair.schema.json",
        "//:scripts/install.sh",
        "//schemas:server-config.schema.json",
    ],
    env_inherit = [
        "DOCKER_CONFIG",
        "DOCKER_HOST",
        "GOFLAGS",
        "GOMAXPROCS",
        "GOMEMLIMIT",
        "PATH",
        "PM_STACK_POSTGRES_PORT",
        "PM_STACK_PROJECT",
        "PM_STACK_PUBLIC_PORT",
        "PM_STACK_ROOT",
        "PM_STACK_S3_PRIMARY_PORT",
        "PM_STACK_S3_SECONDARY_PORT",
        "PM_STACK_SECRETS_DIR",
        "PM_STACK_STATE_DIR",
        "PM_STACK_TEMPORAL_PORT",
        "PM_STACK_TEST_CONFIG",
        "PM_STACK_TEST_S3_PRIMARY_ENDPOINT",
        "PM_STACK_TEST_S3_SECONDARY_ENDPOINT",
    ],
    # Physical qualification requires the explicitly owned local stack and
    # PM_STACK_ROOT; absent fixture inputs fail instead of skipping.
    tags = ["exclusive", "external", "no-remote"],
    deps = [
        "//internal/config",
        "//internal/stack",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_santhosh_tekuri_jsonschema_v6//:jsonschema",
        "@io_temporal_go_sdk//client",
    ],
)
