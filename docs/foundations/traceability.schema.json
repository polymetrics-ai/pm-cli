{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymetrics.ai/schemas/foundation-traceability-v1.json",
  "title": "PM Foundation Atlas authoring projections",
  "oneOf": [
    {
      "$ref": "#/$defs/atlas"
    },
    {
      "$ref": "#/$defs/requirementsDocument"
    }
  ],
  "$defs": {
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "foundationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FND-[0-9]{2}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "ownershipReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "group_id",
        "packet_id"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "packet_id": {
          "type": "string",
          "minLength": 1
        },
        "ownership_package": {
          "type": "string",
          "minLength": 1
        },
        "assignment_owner": {
          "type": "string",
          "minLength": 1
        },
        "go_package": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "ownership_process": {
          "type": "string",
          "minLength": 1
        },
        "packet_process": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "handlerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "symbol",
        "declaration_state"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "declaration_state": {
          "$ref": "#/$defs/declarationState"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pointer",
        "detail"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "handler_unavailable",
            "handler_missing"
          ]
        },
        "pointer": {
          "type": "string",
          "pattern": "^/"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "name",
        "owner",
        "interface",
        "implementation_state",
        "evidence_state",
        "capability_state",
        "dependencies",
        "consumers",
        "files",
        "registration_bindings",
        "requirement_ids",
        "test_ids",
        "gaps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FND-[0-9]{2}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "interface": {
          "type": "string",
          "minLength": 1
        },
        "implementation_state": {
          "type": "string",
          "enum": [
            "planned",
            "unavailable",
            "implemented"
          ]
        },
        "evidence_state": {
          "const": "unexecuted"
        },
        "capability_state": {
          "const": "not_established_by_atlas"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/foundationReference"
          }
        },
        "consumers": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ownershipReference"
          }
        },
        "registration_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/handlerBinding"
          }
        },
        "requirement_ids": {
          "$ref": "#/$defs/strings"
        },
        "test_ids": {
          "$ref": "#/$defs/strings"
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      }
    },
    "handlerDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "path",
        "symbol",
        "declaration_state"
      ],
      "properties": {
        "packet_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "declaration_state": {
          "$ref": "#/$defs/declarationState"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foundations",
        "requirements",
        "packets",
        "declared_paths",
        "actual_go_files"
      ],
      "properties": {
        "foundations": {
          "type": "integer",
          "minimum": 1
        },
        "requirements": {
          "type": "integer",
          "minimum": 1
        },
        "packets": {
          "type": "integer",
          "minimum": 1
        },
        "declared_paths": {
          "type": "integer",
          "minimum": 1
        },
        "actual_go_files": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner_file",
        "symbol",
        "contexts",
        "planned_command",
        "evidence_state"
      ],
      "properties": {
        "id": {
          "const": "V80"
        },
        "owner_file": {
          "const": "tools/traceability_test.go"
        },
        "symbol": {
          "const": "TestTraceabilityClosure"
        },
        "contexts": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "planned_command": {
          "type": "string",
          "minLength": 1
        },
        "evidence_state": {
          "const": "unexecuted"
        }
      }
    },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authority",
        "sources",
        "counts",
        "validation",
        "foundations",
        "handler_declarations",
        "gaps"
      ],
      "properties": {
        "schema_version": {
          "const": "pm.foundation-atlas/v1"
        },
        "authority": {
          "type": "string",
          "pattern": "authoring_projection_only"
        },
        "sources": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/sourceIdentity"
          }
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "foundations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/foundation"
          }
        },
        "handler_declarations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/handlerDeclaration"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "connector",
        "operation",
        "scope_kind",
        "declared_status",
        "foundation_refs",
        "lanes",
        "registration",
        "files",
        "test_ids",
        "required_behavior",
        "admission",
        "existing_evidence",
        "missing_proof",
        "evidence_scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "connector": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "scope_kind": {
          "type": "string"
        },
        "declared_status": {
          "type": "string",
          "minLength": 1
        },
        "foundation_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/foundationReference"
          }
        },
        "lanes": {
          "$ref": "#/$defs/strings"
        },
        "registration": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ownershipReference"
          }
        },
        "test_ids": {
          "$ref": "#/$defs/strings"
        },
        "required_behavior": {
          "$ref": "#/$defs/strings"
        },
        "admission": {
          "type": "string"
        },
        "existing_evidence": {
          "type": "string"
        },
        "missing_proof": {
          "type": "string"
        },
        "evidence_scope": {
          "type": "string"
        }
      }
    },
    "requirementsDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authority",
        "sources",
        "requirements"
      ],
      "properties": {
        "schema_version": {
          "const": "pm.foundation-requirements/v1"
        },
        "authority": {
          "type": "string",
          "pattern": "design_impact_projection_only"
        },
        "sources": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/sourceIdentity"
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      }
    },
    "declarationState": {
      "type": "string",
      "enum": [
        "present",
        "unavailable",
        "missing"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
