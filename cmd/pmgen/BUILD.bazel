load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "pmgen_lib",
    srcs = [
        "connector.go",
        "main.go",
    ],
    importpath = "github.com/polymetrics-ai/pm-cli/cmd/pmgen",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/compile",
        "//internal/contract",
        "//internal/proof",
    ],
)

go_binary(
    name = "pmgen",
    embed = [":pmgen_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "pmgen_test",
    srcs = ["connector_test.go"],
    embed = [":pmgen_lib"],
    deps = [
        "//internal/compile",
        "//internal/contract",
    ],
)
